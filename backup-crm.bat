@echo off\nsetlocal\ncd /d "%~dp0"\nif not exist backups mkdir backups\nif not exist data\leads.db (\n  echo Banco de dados ainda nao existe: data\leads.db\n  pause\n  exit /b 1\n)\nfor /f "tokens=1-4 delims=/ " %%a in ("%date%") do set d=%%a-%%b-%%c\nset t=%time::=-%\nset t=%t: =0%\ncopy /Y "data\leads.db" "backups\leads-%d%-%t:~0,8%.db" >nul\necho Backup concluido na pasta backups.\npause\n